<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.myspringboot.mapper.OrderMapper">

    <select id="selectByUserId" parameterType="string" resultType="com.example.myspringboot.entity.Order">
        SELECT * FROM orders WHERE user_id = #{userId}
    </select>

    <select id="selectByGoodsId" parameterType="string" resultType="com.example.myspringboot.entity.Order">
        SELECT * FROM orders WHERE goods_id = #{goodsId}
    </select>

</mapper>
